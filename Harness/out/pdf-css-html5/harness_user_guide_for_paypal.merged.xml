</opentopic:map><topic xmlns:ot-placeholder="http://suite-sol.com/namespaces/ot-placeholder" break-before="true" is-chapter="true" class="+ topic/topic pdf2-d/placeholder " id="d78e14" topicrefclass="+ map/topicref mapgroup-d/topichead "><title class="- topic/title "><ph class="- topic/ph topic/title-wrapper ">Introduction</ph></title><concept class="- topic/topic concept/concept " id="unique_1" topicrefclass="- map/topicref " nd:nd-id="concept_ghn_snk_53c" oid="concept_ghn_snk_53c" specializations="@props/deliveryTarget">
    <title class="- topic/title "><ph class="- topic/ph topic/title-wrapper ">Overview</ph></title>
    <conbody class="- topic/body  concept/conbody ">
        <p class="- topic/p ">Harness.io manages the full lifecycle of the CI/CD (Continuous Integration/Continuous
            Deployment) process. You can define and automate your build, test, and deployment
            pipelines using easy-to-configure YAML files, and the pipelines can also be
            version-controlled, making updates and changes simpler. Harness supports parallel
            execution of jobs, allowing you to run builds, tests, and deployments
            simultaneously.</p>
    </conbody>
</concept><concept class="- topic/topic concept/concept " id="unique_2" topicrefclass="- map/topicref " nd:nd-id="concept_i1q_bdk_53c" oid="concept_i1q_bdk_53c" specializations="@props/deliveryTarget">
    <title class="- topic/title "><ph class="- topic/ph topic/title-wrapper ">Access and Roles</ph></title>
    <shortdesc class="- topic/shortdesc ">Go to <b class="+ topic/ph hi-d/b ">MyAccess</b> (go/myaccess) to request the necessary roles.</shortdesc>
    <conbody class="- topic/body  concept/conbody ">
        <ul class="- topic/ul " id="unique_2_Connect_42_ul_cbz_2dk_53c" nd:nd-id="ul_cbz_2dk_53c"><li class="- topic/li ">To use Harness:  <b class="+ topic/ph hi-d/b ">PP_SSO_Harness_io_platform_operator</b></li><li class="- topic/li ">To deploy to Production:  <b class="+ topic/ph hi-d/b ">PP_HRZ_SITEAD_Altus_Deployment</b> (you must also have
                current <b class="+ topic/ph hi-d/b ">SRE IPCF Training</b>, previously known as "Think Twice"),</li></ul>
        <p class="- topic/p ">Requests go to your manager for approval and may take 40 minutes to sync. For information
            about other roles, see <b class="+ topic/ph hi-d/b ">Harness.io Roles in MyAccess</b>.</p>
        <p class="- topic/p ">To log in to Harness, go <b class="+ topic/ph hi-d/b ">here</b>, click the "Single sign-on" button, and enter your
            PayPal email address.</p>
    </conbody>
</concept></topic><topic xmlns:ot-placeholder="http://suite-sol.com/namespaces/ot-placeholder" break-before="true" is-chapter="true" class="+ topic/topic pdf2-d/placeholder " id="d78e38" topicrefclass="+ map/topicref mapgroup-d/topichead "><title class="- topic/title "><ph class="- topic/ph topic/title-wrapper ">Onboard Your Application</ph></title><task class="- topic/topic task/task " id="unique_3" topicrefclass="- map/topicref " nd:nd-id="task_cwt_dmk_53c" oid="task_cwt_dmk_53c" specializations="@props/deliveryTarget">
    <title class="- topic/title "><ph class="- topic/ph topic/title-wrapper ">Console (Raptor/Kraken/Node.js)</ph></title>
    <taskbody class="- topic/body task/taskbody ">
        <prereq class="- topic/section task/prereq " id="unique_3_Connect_42_prereq_alw_gmk_53c" nd:nd-id="prereq_alw_gmk_53c">
            <p class="- topic/p ">Make sure you have requested the required roles and that you have completed <b class="+ topic/ph hi-d/b ">SRE
                    IPCF Training</b>.</p>
        </prereq>
        <context class="- topic/section task/context ">
            <p class="- topic/p ">These instructions are for a <b class="+ topic/ph hi-d/b "><u class="+ topic/ph hi-d/u ">new</u></b> application. If your application was
                already onboarded to Harness, see <b class="+ topic/ph hi-d/b ">Harness Pipeline Upgrade</b>.</p>
        </context>
        <steps class="- topic/ol task/steps "><step class="- topic/li task/step ">
                <cmd class="- topic/ph task/cmd ">Go to <b class="+ topic/ph hi-d/b ">Console</b>.</cmd>
            </step><step class="- topic/li task/step ">
                <cmd class="- topic/ph task/cmd ">Navigate to your application by clicking "Applications" in the left nav and
                    then finding it under "Recent" or by using Search.</cmd>
            </step></steps>
    </taskbody>
</task></topic></map>