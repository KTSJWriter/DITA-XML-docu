                            <article xmlns:nd="http://www.oxygenxml.com/css2fo/named-destinations" aria-labelledby="ariaid-title2" class="- topic/topic concept/concept topic concept nested1" css:display="block" css:oxy-pdf-tag-type="Sect" id="unique_1" nd:nd-id="concept_ghn_snk_53c" oid="concept_ghn_snk_53c" specializations="@props/deliveryTarget" topicrefclass="- map/topicref ">
                                <h2 class="- topic/title title topictitle2" css:bookmark-level="2" css:bookmark-state="closed" css:break-after="avoid" css:display="block" css:font-size="1.7em" css:margin-bottom="0.5em" css:margin-left="0" css:margin-right="0" css:margin-top="1em" css:oxy-pdf-tag-type="H2" id="ariaid-title2"><css:bookmark-label><css:content source="before"/><css:content source="text"/></css:bookmark-label><span class="- topic/ph topic/title-wrapper ph title-wrapper" css:display="inline">Overview</span></h2>
                                <div class="- topic/body concept/conbody body conbody" css:display="block" css:margin-bottom="0" css:margin-left="0" css:margin-right="0" css:margin-top="0">
                                    <p class="- topic/p p" css:display="block" css:margin-bottom="0.5em" css:margin-left="0" css:margin-right="0" css:margin-top="1em">Harness.io manages
                                        the full lifecycle of the CI/CD (Continuous
                                        Integration/Continuous Deployment) process. You can define
                                        and automate your build, test, and deployment pipelines
                                        using easy-to-configure YAML files, and the pipelines can
                                        also be version-controlled, making updates and changes
                                        simpler. Harness supports parallel execution of jobs,
                                        allowing you to run builds, tests, and deployments
                                        simultaneously.</p>
                                </div>
                            </article>
                            <article xmlns:nd="http://www.oxygenxml.com/css2fo/named-destinations" aria-labelledby="ariaid-title3" class="- topic/topic concept/concept topic concept nested1" css:display="block" css:oxy-pdf-tag-type="Sect" id="unique_2" nd:nd-id="concept_i1q_bdk_53c" oid="concept_i1q_bdk_53c" specializations="@props/deliveryTarget" topicrefclass="- map/topicref ">
